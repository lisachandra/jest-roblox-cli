// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`StudioCliBackend > should write a bootstrap that drives ExecuteRunModeAsync over a result socket 1`] = `
"_G.__JEST__ = true
local HttpService = game:GetService("HttpService")
local StudioTestService = game:GetService("StudioTestService")
local payload = HttpService:JSONDecode([=[{"protocolVersion":7,"requestId":"<request-id>","resultsUrl":"http://localhost:<port>/results","test":true,"config":{"configs":[{"testMatch":["**/*.spec","**/*.spec","**/*.test","**/*.test","**/*.spec-d","**/*.test-d","**/*.spec","**/*.spec","**/*.test","**/*.test"],"passWithNoTests":false,"silent":false,"testPathIgnorePatterns":["/node_modules/","/dist/","/out/"],"verbose":false,"testNamePattern":"alpha-pattern","runnerTimeoutMs":60000,"reporters":[]}]},"runtimeStubMounts":[[]]}]=])
local URL = "http://localhost:<port>/results"
local REQUEST_ID = [=[<request-id>]=]
local ok, result = pcall(function()
	return StudioTestService:ExecuteRunModeAsync(payload)
end)
local message
if not ok then
	-- If the plugin in Run Mode already posted the results directly to the results server,
	-- the host closes the server and terminates Studio, so a failing ExecuteRunModeAsync
	-- during post-run boundary teardown is ignored.
	message = { type = "results", requestId = REQUEST_ID, gameOutput = "[]", jestOutput = HttpService:JSONEncode({ err = tostring(result), success = false }) }
elseif typeof(result) ~= "table" or result.jestOutput == nil then
	message = { type = "results", requestId = REQUEST_ID, gameOutput = "[]", jestOutput = HttpService:JSONEncode({ err = "studio-cli: the jest plugin produced no result. Install or update the jest-roblox Studio plugin.", success = false }) }
else
	message = { type = "results", requestId = REQUEST_ID, protocolVersion = result.protocolVersion, pluginVersion = result.pluginVersion, gameOutput = result.gameOutput or "[]", jestOutput = result.jestOutput }
end
_G.__JEST__ = true
local encoded = HttpService:JSONEncode(message)
local sent = false
local start = os.clock()
while not sent and os.clock() - start < 30 do
	local ok, response = pcall(function()
		return HttpService:RequestAsync({
			Url = URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = encoded,
		})
	end)
	if ok and typeof(response) == "table" and response.Success and response.StatusCode == 200 then
		sent = true
		break
	end
	task.wait(0.1)
end
if not sent then
	print("studio-cli: failed to post results to host")
	-- Deliver a clean failure envelope instead of letting the run hang until
	-- the CLI's deadline: EndTest is what the CLI surfaces in its log tail.
	message = { type = "results", requestId = REQUEST_ID, gameOutput = "[]", jestOutput = HttpService:JSONEncode({ err = "studio-cli: failed to post results to host", success = false }) }
	local endOk, endErr = pcall(function()
		StudioTestService:EndTest({ jestOutput = message.jestOutput, gameOutput = message.gameOutput, protocolVersion = payload.protocolVersion })
	end)
	if not endOk then
		print("studio-cli: EndTest fallback failed: " .. tostring(endErr))
	end
end
"
`;
